# Staging Environment Variables
# Copy this to .env.staging and fill in actual values

# Database
DATABASE_NAME=auth1_staging
DATABASE_USER=auth1_staging
DATABASE_PASSWORD=staging_secure_password_here
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_SSL_MODE=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=staging_redis_secure_password_here

# Application
APP_ENVIRONMENT=staging
LOG_LEVEL=debug

# RabbitMQ
AMQP_URL=amqp://auth1:staging_rabbitmq_password@rabbitmq:5672/
