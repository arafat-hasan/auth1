# Production Environment Variables
# Copy this to .env.prod and fill in actual values
# NEVER commit .env.prod to version control!

# Database
DATABASE_NAME=auth1_prod
DATABASE_USER=auth1_prod
DATABASE_PASSWORD=    # REQUIRED: Strong production password
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_SSL_MODE=require

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=    # REQUIRED: Strong Redis password

# Application
APP_ENVIRONMENT=production
LOG_LEVEL=info
HTTP_PORT=8080

# JWT
JWT_SECRET=    # REQUIRED: Generate with: openssl rand -base64 64

# RabbitMQ
AMQP_URL=    # REQUIRED: amqp://user:password@rabbitmq:5672/

# Optional: External services
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
